<Window
    x:Class="ArchiWindRevitAddIn.Views.ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewModel="clr-namespace:ArchiWindRevitAddIn.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModel:ProgressViewModel}"
    Title="{Binding Title}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Height="Auto"
    Width="600"
    SizeToContent="Height"
    Icon="/ArchiWindRevitAddIn;component/Resources/Icons/icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="0" 
                     Height="25" 
                     Value="{Binding ProgressValue}"
                     Maximum="{Binding ProgressMaximum}"
                     Margin="0,0,0,10"/>

        <!-- Log Messages -->
        <GroupBox Grid.Row="1" Header="Log" Margin="0,0,0,10" Padding="5">
            <ListBox ItemsSource="{Binding LogMessages}"
                     MinHeight="150"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}" 
                    Width="75" 
                    Margin="0,5,10,5"
                    IsCancel="True"
                    Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Done" 
                    Command="{Binding CloseCommand}" 
                    Width="74" 
                    Margin="0,5"
                    IsDefault="True"
                    Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</Window>