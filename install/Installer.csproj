<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <TargetFramework>net10.0-windows</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="Resources\Icons\BackgroundImage.png" />
      <None Remove="Resources\Icons\BannerImage.png" />
      <None Remove="Resources\Icons\icon.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="WixSharp.Core" Version="2.14.0" />
        <PackageReference Include="WixSharp.Msi.Core" Version="2.14.0" />
    </ItemGroup>

    <ItemGroup>
      <Resource Include="Resources\Icons\BackgroundImage.png" />
      <Resource Include="Resources\Icons\BannerImage.png" />
      <Resource Include="Resources\Icons\icon.ico" />
    </ItemGroup>

</Project>